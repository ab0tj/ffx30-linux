 #include "spi-bitbang-txrx.h"
 
+static u32 spi_gpio_reverse_word(u32 word, u8 bits)
+{
+	u32 reversed = 0;
+	u8 i;
+
+	for (i = 0; i < bits; i++) {
+		reversed <<= 1;
+		reversed |= word & 1;
+		word >>= 1;
+	}
+
+	return reversed;
+}
+
+static u32 spi_gpio_txrx_word(struct spi_device *spi, unsigned int nsecs,
+		unsigned int cpol, unsigned int cpha, unsigned int flags,
+		u32 word, u8 bits)
+{
+	bool lsb_first = spi->mode & SPI_LSB_FIRST;
+
+	if (lsb_first)
+		word = spi_gpio_reverse_word(word, bits);
+
+	if (cpha)
+		word = bitbang_txrx_be_cpha1(spi, nsecs, cpol, flags,
+					      word, bits);
+	else
+		word = bitbang_txrx_be_cpha0(spi, nsecs, cpol, flags,
+					      word, bits);
+
+	if (lsb_first)
+		word = spi_gpio_reverse_word(word, bits);
+
+	return word;
+}
+
