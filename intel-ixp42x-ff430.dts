// SPDX-License-Identifier: ISC
/*
 * Device Tree file for the MultiTech FaxFinder FFx30/FF430.
 * This machine is based on a 533 MHz Intel IXP425.
 */

/dts-v1/;

#include "intel-ixp42x.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "MultiTech FaxFinder FFx30";
	compatible = "multitech,ff430", "intel,ixp42x";
	#address-cells = <1>;
	#size-cells = <1>;

	aliases {
		serial0 = &uart0;
	};

	chosen {
		bootargs = "console=ttyS0,115200n8 root=/dev/sda1 rootwait rw init=/sbin/init";
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>;
	};

	spi-rtc {
		compatible = "spi-gpio";
		#address-cells = <1>;
		#size-cells = <0>;

		/* Wiring recovered from the stock DS1302 driver. */
		sck-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		mosi-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
		cs-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
		num-chipselects = <1>;

		rtc@0 {
			compatible = "maxim,ds1302";
			reg = <0>;
			spi-max-frequency = <500000>;
			spi-3wire;
			spi-lsb-first;
			spi-cs-high;
		};
	};

	soc {
		bus@c4000000 {
			flash@0,0 {
				compatible = "intel,ixp4xx-flash", "cfi-flash";
				bank-width = <2>;
				/* Enable writes on the expansion bus */
				intel,ixp4xx-eb-write-enable = <1>;
				/* 16 MB of Flash mapped in at CS0 */
				reg = <0 0x00000000 0x1000000>;

				partitions {
					compatible = "redboot-fis";
					/* Eraseblock at 0x0fe0000 */
					fis-index-block = <0x7f>;
				};
			};

			ide@1,0 {
				compatible = "intel,ixp4xx-compact-flash";

				intel,ixp4xx-eb-t1 = <3>;
				intel,ixp4xx-eb-t2 = <3>;
				intel,ixp4xx-eb-t3 = <15>;
				intel,ixp4xx-eb-t4 = <3>;
				intel,ixp4xx-eb-t5 = <15>;
				intel,ixp4xx-eb-cycle-type = <0>;
				intel,ixp4xx-eb-byte-access-on-halfword = <1>;
				intel,ixp4xx-eb-mux-address-and-data = <0>;
				intel,ixp4xx-eb-ahb-split-transfers = <0>;
				intel,ixp4xx-eb-write-enable = <1>;
				intel,ixp4xx-eb-byte-access = <1>;

				reg = <1 0x00000000 0x00000200>,
				      <2 0x00000000 0x00000200>;

				status = "okay";
			};

			modem-reset@3,0 {
				compatible = "multitech,ff430-modem-reset";

				/*
				 * Modem reset latch on expansion-bus chip select 3.
				 * Matches the stock driver's CS3 value 0xbfff0003.
				 */
				intel,ixp4xx-eb-t1 = <3>;
				intel,ixp4xx-eb-t2 = <3>;
				intel,ixp4xx-eb-t3 = <15>;
				intel,ixp4xx-eb-t4 = <3>;
				intel,ixp4xx-eb-t5 = <15>;
				intel,ixp4xx-eb-cycle-type = <0>;
				intel,ixp4xx-eb-byte-access-on-halfword = <0>;
				intel,ixp4xx-eb-mux-address-and-data = <0>;
				intel,ixp4xx-eb-ahb-split-transfers = <0>;
				intel,ixp4xx-eb-write-enable = <1>;
				intel,ixp4xx-eb-byte-access = <1>;

				reg = <3 0x00000000 0x00000200>;
				status = "okay";
			};
		};

		/* EthB: Connected to Micrel PHY */
		ethernet@c8009000 {
			status = "okay";

			//intel,mdio-only;
			queue-rx = <&qmgr 3>;
			queue-txready = <&qmgr 20>;
			intel,npe-handle = <&npe 1>;

			phy-mode = "mii";
			phy-handle = <&phy1>;

			mdio {
				#address-cells = <1>;
				#size-cells = <0>;

				phy1: ethernet-phy@1 {
					reg = <1>;
				};
			};
		};

		pci@c0000000 {
			status = "okay";

			/* Exar serial chip is on slot 13 */
			interrupt-map =
			<0x6800 0 0 1 &gpio0 7 IRQ_TYPE_LEVEL_LOW>;
		};
	};
};
